{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"preset": "__defaultBuildPreset__",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$msCompile",
				"$gcc"
			],
			"detail": "Builds the active CMake preset's default target"
		},
		{
			"type": "cmake",
			"label": "CMake: test",
			"command": "test",
			"preset": "__defaultTestPreset__",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": [],
			"detail": "Runs ctest for the active preset"
		}
	]
}
